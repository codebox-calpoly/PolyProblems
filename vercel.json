{
  "buildCommand": "cd frontend && npx expo export -p web && cd .. && cp -r landing frontend/dist/landing",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { 
      "source": "/landing", 
      "destination": "/landing/index.html" 
    },
    { 
      "source": "/landing/(.*)", 
      "destination": "/landing/$1" 
    },
    { 
      "source": "/((?!landing).*)", 
      "destination": "/index.html" 
    }
  ]
}