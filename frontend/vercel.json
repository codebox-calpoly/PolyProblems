{
  "buildCommand": "npx expo export -p web && cp -r ../landing ./dist/landing && cp -r ../privacy ./dist/privacy && cp -r ../terms ./dist/terms",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing/index.html"
    },
    {
      "source": "/landing",
      "destination": "/landing/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy/(.*)",
      "destination": "/privacy/$1"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/terms/(.*)",
      "destination": "/terms/$1"
    },
    {
      "source": "/((?!landing|privacy|terms).+)",
      "destination": "/index.html"
    }
  ]
}
